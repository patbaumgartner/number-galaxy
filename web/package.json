{
  "name": "number-galaxy",
  "version": "0.0.0",
  "private": true,
  "description": "Number Galaxy (Zahlen-Galaxie): four free, privacy-friendly maths games for children — seeing quantities, doubling on a bar model, a one-tap arcade and a times-tables trainer. No account, no ads, no tracking, works offline.",
  "keywords": [
    "education",
    "mathematics",
    "children",
    "number-sense",
    "subitizing",
    "times-tables",
    "bar-model",
    "react",
    "typescript",
    "pwa",
    "offline-first"
  ],
  "homepage": "https://patbaumgartner.github.io/number-galaxy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patbaumgartner/number-galaxy.git",
    "directory": "web"
  },
  "bugs": {
    "url": "https://github.com/patbaumgartner/number-galaxy/issues"
  },
  "license": "MIT",
  "author": "Patrick Baumgartner",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:all": "npm run test && npm run test:e2e",
    "preview": "vite preview",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.13.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.10.0",
    "jsdom": "^30.0.1",
    "typescript": "~7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
